+// Query the decoder session itself, rather than inferring hardware from frames.
+int av_videotoolbox_is_hardware_accelerated(AVCodecContext *avctx)
+{
+    AVVideotoolboxContext *videotoolbox = videotoolbox_get_context(avctx);
+    CFTypeRef value = NULL;
+    OSStatus status;
+    int result = AVERROR(EINVAL);
+
+    if (!videotoolbox || !videotoolbox->session)
+        return result;
+    status = VTSessionCopyProperty(videotoolbox->session,
+                                  kVTDecompressionPropertyKey_UsingHardwareAcceleratedVideoDecoder,
+                                  kCFAllocatorDefault, &value);
+    if (status == noErr && value && CFGetTypeID(value) == CFBooleanGetTypeID())
+        result = CFBooleanGetValue(value) ? 1 : 0;
+    if (value)
+        CFRelease(value);
+    return result;
+}
+
 static void videotoolbox_stop(AVCodecContext *avctx)
 {
     AVVideotoolboxContext *videotoolbox = videotoolbox_get_context(avctx);
